{% extends '@Contao/content_element/_base.html.twig' %}

{% block style %}
    {# The default stylesheet only styles the initials, so it is only needed for persons without a photo #}
    {% if addStylesheet|default(true) and persons|filter(person => not person.figure|default)|length > 0 %}
        {% add 'cgoit_persons_css' to head %}
            <link rel="stylesheet" href="{{ asset('persons-css.css', 'cgoit_persons') }}">
        {% endadd %}
    {% endif %}
{% endblock %}

{% block content %}
    <div class="persons">
        {% for person in persons %}
            {{ include('@Contao/' ~ person.personTpl, person.arrData) }}
            {% block schema_org %}
                {% if addSchemaOrg|default(true) and person.schemaOrgData|default(false) %}
                    {% do add_schema_org(person.schemaOrgData) %}
                {% endif %}
            {% endblock %}
        {% endfor %}
    </div>
{% endblock %}
